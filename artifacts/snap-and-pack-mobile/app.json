{
  "expo": {
    "name": "Snap & Pack",
    "slug": "snap-and-pack-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snap-and-pack-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2D6"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.buildersweekend.snapandpack",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F2D6"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "カバンの中身を撮影して忘れ物をチェックするためにカメラを使用します"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "今日の予定に合わせた持ち物リストを提案するためにカレンダーを読み取ります"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
