<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Snap &amp; Pack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wasuremono_zero</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- image_picker: Camera access -->
	<key>NSCameraUsageDescription</key>
	<string>カバンの中身を撮影するために使います。(Used to photograph your belongings for the packing check.)</string>

	<!-- image_picker: Photo library read -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>所持アイテムの参照写真を選ぶために使います。(Used to select reference photos of your items.)</string>

	<!-- image_picker: Photo library write (saving photos) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>撮影した写真をライブラリへ保存するために使います。(Used to save captured photos to your library.)</string>

	<!-- device_calendar: Calendar read/write (iOS 16 and earlier) -->
	<key>NSCalendarsUsageDescription</key>
	<string>今日の予定から持ち物を提案するために使います。(Used to suggest packing items based on today's calendar events.)</string>

	<!-- device_calendar: Full calendar access (iOS 17+) -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>今日の予定から持ち物を提案するために使います。(Used to suggest packing items based on today's calendar events.)</string>

	<!-- device_calendar: Write-only calendar access (iOS 17+) -->
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>カレンダーへイベントを書き込むために使います。(Used to write events to your calendar.)</string>

	<!-- flutter_tts: Microphone (not strictly required but avoids App Store rejection) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>音声読み上げ機能のために使います。(Used by the text-to-speech feature.)</string>
</dict>
</plist>
